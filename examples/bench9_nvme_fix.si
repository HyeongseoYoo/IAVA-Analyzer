// Benchmark 9: NVMe Command Queue Manager (SSD HIL) — FIXED VERSION
//
// Fix strategy:
//   FIX-1 (Pattern 1): Wrap the CmdSlot read and SqBuf/CqBuf accesses inside
//     a disable/enable critical section so handler 0 cannot overwrite CmdSlot
//     between the while-condition check and the array writes.  A two-level
//     bounds guard (>= 0, then < MAX_CMDS) eliminates both left and right OOB.
//
//   FIX-2 (Pattern 2): Wrap the NvmeCtrl[REG_PRPPTR] read inside a
//     disable/enable section.  This prevents handler 1 from writing INVALID_CID
//     into NvmeRegs[REG_PRPPTR] between the read and the PrpList write.
//     An explicit bounds guard on SafePrpPtr eliminates residual OOB widening.
//
//   FIX-3 (Pattern 3): Disable interrupts while reading through the 3-level heap
//     alias chain.  Disable interrupts before reading EngineRef[REG_PRPPTR] and
//     re-enable immediately after capturing the value into SafePrpPtr2.  The
//     bounds guard on SafePrpPtr2 then prevents OOB into PrpList2 even if the
//     captured value is later seen as unconstrained.
//
// handler 0 — NVME_ERR_EVT  : sets CmdSlot := INVALID_CID (Pattern 1 bug source)
// handler 1 — TIMEOUT_EVT   : sets NvmeRegs[REG_PRPPTR] := INVALID_CID (Pattern 2 bug source)
// handler 2 — CQ_FULL_EVT   : corrupts DmaConfig[REG_PRPPTR] via alias (Pattern 3 bug)
// handler 3 — DOORBELL_EVT  : increments SQ tail, logs doorbell event

init {
  // === Array sizes ===
  MAX_CMDS      := 16;
  PRP_LIST_SZ   := 16;
  CQ_BUF_SZ     := 16;
  SQ_BUF_SZ     := 16;
  ERR_LOG_SZ    := 16;
  EVENT_LOG_SZ  := 32;
  DIAG_BUF_SZ   := 8;
  NVME_REG_SZ   := 16;

  // === Error / abort sentinel ===
  INVALID_CID   := 255;
  ERR_NONE      := 0;
  ERR_INVAL_CMD := 1;
  ERR_TIMEOUT   := 2;
  ERR_ABORT     := 3;
  ERR_MEDIA     := 4;
  ERR_INTERNAL  := 5;
  ERR_DATA      := 6;
  ERR_POWER     := 7;

  // === Command states ===
  CMD_FREE      := 0;
  CMD_PENDING   := 1;
  CMD_ACTIVE    := 2;
  CMD_COMPLETE  := 3;
  CMD_ABORT     := 4;
  CMD_ERROR     := 5;

  // === NvmeRegs field indices ===
  REG_STATUS    := 0;
  REG_PRPPTR    := 1;
  REG_SQTAIL    := 2;
  REG_CQHEAD    := 3;
  REG_ERRCNT    := 4;
  REG_CMDCNT    := 5;
  REG_ABORTCNT  := 6;
  REG_FLAGS     := 7;
  REG_TIMEOUT   := 8;
  REG_LASTCID   := 9;

  // === Trace markers ===
  MARK_SUBMIT   := 10;
  MARK_COMPLETE := 20;
  MARK_ERROR    := 30;
  MARK_ABORT    := 40;
  MARK_TIMEOUT  := 50;
  MARK_DOORBELL := 60;
  MARK_FLUSH    := 70;
  MARK_RESET    := 80;

  // === State variables ===
  CmdSlot       := 0;
  CqHead        := 0;
  SqTail        := 0;
  CmdPending    := 0;
  CmdDone       := 0;
  ErrCode       := ERR_NONE;
  ErrCount      := 0;
  AbortCount    := 0;
  TimeoutCount  := 0;
  DoorbellCount := 0;
  EventHead     := 0;
  EventCount    := 0;
  LastPrpPtr    := 0;
  SafePrpPtr    := 0;
  SafePrpPtr2   := 0;
  DiagIdx       := 0;

  // === Arrays ===
  SqBuf    := malloc(16, CMD_FREE);
  CqBuf    := malloc(16, 0);
  PrpList  := malloc(16, 0);
  ErrLog   := malloc(16, ERR_NONE);
  EventLog := malloc(32, 0);
  DiagBuf  := malloc(8, 0);
  NvmeRegs     := malloc(16, 0);
  PrpList2     := malloc(16, 0);
  DmaConfig    := malloc(16, 0);
  DmaDescTable := malloc(4, 0);

  // Initialize NvmeRegs
  *NvmeRegs[REG_STATUS]   := ERR_NONE;
  *NvmeRegs[REG_PRPPTR]   := 0;
  *NvmeRegs[REG_SQTAIL]   := 0;
  *NvmeRegs[REG_CQHEAD]   := 0;
  *NvmeRegs[REG_ERRCNT]   := 0;
  *NvmeRegs[REG_CMDCNT]   := 0;
  *NvmeRegs[REG_ABORTCNT] := 0;
  *NvmeRegs[REG_FLAGS]    := 0;
  *NvmeRegs[REG_TIMEOUT]  := 0;
  *NvmeRegs[REG_LASTCID]  := 0;

  // Initialize DMA descriptor table: slot 0 points to DmaConfig
  *DmaDescTable[0] := DmaConfig;
  *DmaConfig[REG_PRPPTR] := 0;

  // Initialize SQ entries
  *SqBuf[0] := CMD_FREE;
  *SqBuf[1] := CMD_FREE;
  *SqBuf[2] := CMD_FREE;
  *SqBuf[3] := CMD_FREE;

  handler 0 {
    ErrCode       := ERR_INVAL_CMD;
    ErrCount      := ErrCount + 1;
    AbortCount    := AbortCount + 1;
    CmdSlot       := INVALID_CID;
    *NvmeRegs[REG_STATUS]   := ERR_INVAL_CMD;
    *NvmeRegs[REG_ERRCNT]   := ErrCount;
    *NvmeRegs[REG_ABORTCNT] := AbortCount;
    *NvmeRegs[REG_FLAGS]    := ERR_INVAL_CMD;
    if EventHead < EVENT_LOG_SZ
    then *EventLog[EventHead] := MARK_ERROR
    else unit;
    EventHead     := EventHead + 1;
    EventCount    := EventCount + 1
  };

  handler 1 {
    TimeoutCount  := TimeoutCount + 1;
    ErrCount      := ErrCount + 1;
    *NvmeRegs[REG_PRPPTR]  := INVALID_CID;
    *NvmeRegs[REG_ERRCNT]  := ErrCount;
    *NvmeRegs[REG_TIMEOUT] := TimeoutCount;
    *NvmeRegs[REG_FLAGS]   := ERR_TIMEOUT;
    if EventHead < EVENT_LOG_SZ
    then *EventLog[EventHead] := MARK_TIMEOUT
    else unit;
    EventHead     := EventHead + 1;
    EventCount    := EventCount + 1
  };

  handler 2 {
    // CQ_FULL_EVT — advances CQ head; on overflow also resets DMA PRP pointer
    // Pattern 3 bug (2-level alias):
    //   HandlerDmaPtr aliases DmaConfig directly (level 1)
    //   then writes INVALID_CID through it (level 2)
    CmdDone       := CmdDone + 1;
    CqHead        := CqHead + 1;
    *NvmeRegs[REG_CQHEAD] := CqHead;
    *NvmeRegs[REG_CMDCNT] := CmdDone;
    HandlerDmaPtr := DmaConfig;                   // level 1: alias to DmaConfig
    *HandlerDmaPtr[REG_PRPPTR] := INVALID_CID;    // level 2: corrupt PRP pointer
    if EventHead < EVENT_LOG_SZ
    then *EventLog[EventHead] := MARK_COMPLETE
    else unit;
    EventHead     := EventHead + 1
  };

  handler 3 {
    DoorbellCount := DoorbellCount + 1;
    SqTail        := SqTail + 1;
    *NvmeRegs[REG_SQTAIL] := SqTail;
    if EventHead < EVENT_LOG_SZ
    then *EventLog[EventHead] := MARK_DOORBELL
    else unit;
    EventHead     := EventHead + 1
  }
}

main {
  // Pattern 2: NvmeCtrl aliases NvmeRegs (same BAR0 register block)
  NvmeCtrl := NvmeRegs;

  // Pattern 3: 3-level chain from main via heap-stored pointer alias
  // DmaDescTable[0] holds the DmaConfig address (pointer stored in heap).
  // Level 1: SysRef is a var alias to DmaDescTable (simple, visible in source).
  // Level 2: EngineRef is loaded by dereferencing SysRef[0] — this is the
  //          pointer alias: EngineRef aliases DmaConfig because DmaDescTable[0]
  //          stores DmaConfig's address.  Unlike a plain "x := y" assignment,
  //          the aliasing here is established through heap storage and is not
  //          visible at the EngineRef assignment site alone.
  SysRef    := DmaDescTable;  // level 1: var alias to the descriptor table
  EngineRef := *SysRef[0];   // level 2: heap dereference — EngineRef aliases DmaConfig

  // Phase 1: flush SQ, CQ, and error log
  CmdSlot := 0;
  while CmdSlot < MAX_CMDS do (
    *SqBuf[CmdSlot]  := CMD_FREE;
    *CqBuf[CmdSlot]  := 0;
    *ErrLog[CmdSlot] := ERR_NONE;
    CmdSlot          := CmdSlot + 1
  );
  CmdSlot := 0;

  *EventLog[0] := MARK_RESET;
  *EventLog[1] := ERR_NONE;
  EventHead    := 2;
  *DiagBuf[0]  := CmdSlot;
  *DiagBuf[1]  := ErrCode;

  // Phase 2: pre-load SQ with pending commands
  while CmdSlot < MAX_CMDS do (
    *SqBuf[CmdSlot] := CMD_PENDING;
    CmdSlot         := CmdSlot + 1
  );
  CmdSlot := 0;

  // Phase 3: main command dispatch loop
  while CmdSlot < MAX_CMDS do (
    *DiagBuf[0] := CmdSlot;
    *DiagBuf[1] := ErrCode;

    // [FIX-1] Disable interrupts, re-check CmdSlot bounds before array access.
    disable;
    if CmdSlot < MAX_CMDS
      then (
        *SqBuf[CmdSlot] := CMD_ACTIVE;
        *CqBuf[CmdSlot] := ErrCode
      )
    else unit;
    enable;


    if ErrCode = ERR_NONE
    then (
      *EventLog[EventHead] := MARK_COMPLETE;
      EventHead := EventHead + 1;
      CmdDone := CmdDone + 1
    )
    else (
      *EventLog[EventHead] := MARK_ERROR;
      EventHead := EventHead + 1;
      ErrCount := ErrCount + 1
    );

    // [FIX-2] Disable interrupts while reading PRP pointer through NvmeCtrl.
    // Handler 1 cannot corrupt NvmeRegs[REG_PRPPTR] in this window.
    disable;
    SafePrpPtr := *NvmeCtrl[REG_PRPPTR];
    enable;
    if SafePrpPtr < PRP_LIST_SZ
    then (
      *PrpList[SafePrpPtr] := CmdSlot
    )
    else (
      *PrpList[0] := CmdSlot
    );
    LastPrpPtr := SafePrpPtr;

    // [FIX-3] Disable interrupts while reading through the 3-level heap alias chain.
    // Without the critical section, handler 2 could corrupt DmaConfig[REG_PRPPTR]
    // between the bounds check on *EngineRef[REG_PRPPTR] and its use as an index.
    disable;
    SafePrpPtr2 := *EngineRef[REG_PRPPTR];
    enable;
    if SafePrpPtr2 < PRP_LIST_SZ
    then (
      *PrpList2[SafePrpPtr2] := CmdSlot
    )
    else unit;

    *DiagBuf[2] := LastPrpPtr;
    *DiagBuf[3] := ErrCount;
    *DiagBuf[4] := CmdDone;
    *DiagBuf[5] := AbortCount;

    CmdSlot := CmdSlot + 1;
    *NvmeRegs[REG_LASTCID] := CmdSlot
  );

  // Phase 4: CQ drain loop
  CqHead := 0;
  while CqHead < MAX_CMDS do (
    *DiagBuf[6] := CqHead;
    if *CqBuf[CqHead] = CMD_PENDING
    then (
      *CqBuf[CqHead] := CMD_COMPLETE;
      *EventLog[EventHead] := MARK_COMPLETE;
      EventHead := EventHead + 1
    )
    else (
      *CqBuf[CqHead] := 0
    );
    CqHead := CqHead + 1
  );

  // Phase 5: error log scan and statistics
  CmdSlot := 0;
  while CmdSlot < ERR_LOG_SZ do (
    if *ErrLog[CmdSlot] = ERR_NONE
    then ( *DiagBuf[0] := CmdSlot )
    else (
      *DiagBuf[1] := *ErrLog[CmdSlot];
      ErrCount := ErrCount + 1
    );
    CmdSlot := CmdSlot + 1
  );

  *NvmeRegs[REG_ERRCNT] := ErrCount;
  *NvmeRegs[REG_CMDCNT] := CmdDone;
  *NvmeRegs[REG_STATUS] := ERR_NONE;

  *DiagBuf[0] := ErrCount;
  *DiagBuf[1] := CmdDone;
  *DiagBuf[2] := AbortCount;
  *DiagBuf[3] := TimeoutCount;
  *DiagBuf[4] := DoorbellCount;
  *DiagBuf[5] := EventCount;
  *DiagBuf[6] := LastPrpPtr;
  *DiagBuf[7] := ErrCode;

  // Phase 6: final NVMe state snapshot
  *EventLog[EventHead] := MARK_FLUSH;
  EventHead := EventHead + 1;
  *EventLog[EventHead] := ErrCount;
  EventHead := EventHead + 1;
  *EventLog[EventHead] := CmdDone;
  EventHead := EventHead + 1;
  *EventLog[EventHead] := AbortCount;
  EventHead := EventHead + 1;
  *EventLog[EventHead] := TimeoutCount;
  EventHead := EventHead + 1;
  *NvmeRegs[REG_STATUS] := ERR_NONE;
  *NvmeRegs[REG_CMDCNT] := CmdDone;
  *NvmeRegs[REG_ERRCNT] := ErrCount;
  *NvmeRegs[REG_LASTCID] := CmdSlot
}
