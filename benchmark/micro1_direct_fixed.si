// micro1_direct_fixed.si — Pattern 1: direct shared scalar variable (FIXED)
// Fix: disable before re-checking SlotIdx; no handler can fire in the window.
// Expected: 0 interrupt warnings
// Safe because: SlotIdx narrowed inside critical section, SqBuf[SlotIdx] in [0,7]
//
init {
  // === Array sizes ===
  MAX_SLOTS  := 8;
  PRP_SZ     := 8;
  TX_TOTAL   := 10;
  REG_SZ     := 4;

  // === OOB sentinel ===
  ABORT_SLOT := 255;

  // === Register field indices ===
  REG_STATUS := 0;
  REG_PRPPTR := 1;
  REG_ERRCNT := 2;

  // === Error codes ===
  ERR_NONE    := 0;
  ERR_INVAL   := 1;
  ERR_TIMEOUT := 2;

  // === State variables ===
  SlotIdx  := 0;
  ErrCode  := 0;
  ErrCount := 0;

  // === Arrays ===
  SqBuf     := malloc(8, 0);
  RegFile   := malloc(4, 0);
  PrpList   := malloc(8, 0);
  DmaConf   := malloc(4, 0);
  DescTable := malloc(4, 0);
  PrpList2  := malloc(8, 0);
  TxBuf     := malloc(8, 0);
  DiagBuf   := malloc(4, 0);

  // === Initialize shared heap state ===
  *RegFile[REG_PRPPTR] := 0;
  *DescTable[0]        := DmaConf;
  *DmaConf[REG_PRPPTR] := 0;

  handler 0 {
    // NVME_ERR_EVT: corrupts SlotIdx (direct scalar) — bug source for micro1
    ErrCode  := ERR_INVAL;
    ErrCount := ErrCount + 1;
    SlotIdx  := ABORT_SLOT
  };

  handler 1 {
    // TIMEOUT_EVT: corrupts RegFile[REG_PRPPTR] — bug source for micro2
    ErrCount             := ErrCount + 1;
    *RegFile[REG_PRPPTR] := ABORT_SLOT
  };

  handler 2 {
    // CQ_FULL_EVT: corrupts DmaConf[REG_PRPPTR] via 1-level alias — bug source for micro3
    DmaPtr              := DmaConf;
    *DmaPtr[REG_PRPPTR] := ABORT_SLOT
  }
}

main {
  SlotIdx := 0;
  while SlotIdx < MAX_SLOTS do (
    // [FIX-1] Disable interrupts and re-check SlotIdx before the write.
    // No handler can fire between the if-check and the SqBuf access,
    // so SlotIdx stays in [0, MAX_SLOTS-1] and the write is safe.
    disable;
    if SlotIdx < MAX_SLOTS
    then *SqBuf[SlotIdx] := ERR_NONE
    else unit;
    enable;
    SlotIdx := SlotIdx + 1
  )
}
