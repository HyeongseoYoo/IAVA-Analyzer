// micro2_alias1_fixed.si — Pattern 2: 1-depth pointer alias (FIXED)
// Fix: snapshot RegFile[REG_PRPPTR] into SafePrp inside disable/enable.
// Expected: 0 interrupt warnings
// Safe because: SafePrp is a plain variable no handler writes, so the
// if-check narrowing is stable in the then-branch.
//
init {
  // === Array sizes ===
  MAX_SLOTS  := 8;
  PRP_SZ     := 8;
  TX_TOTAL   := 10;
  REG_SZ     := 4;

  // === OOB sentinel ===
  ABORT_SLOT := 255;
  LEFT_ABORT_SLOT := -1;

  // === Register field indices ===
  REG_STATUS := 0;
  REG_PRPPTR := 1;
  REG_ERRCNT := 2;

  // === Error codes ===
  ERR_NONE    := 0;
  ERR_INVAL   := 1;
  ERR_TIMEOUT := 2;

  // === State variables ===
  SlotIdx  := 0;
  ErrCode  := 0;
  ErrCount := 0;

  // === Arrays ===
  SqBuf     := malloc(8, 0);
  RegFile   := malloc(4, 0);
  PrpList   := malloc(8, 0);
  DmaConf   := malloc(4, 0);
  DescTable := malloc(4, 0);
  PrpList2  := malloc(8, 0);
  TxBuf     := malloc(8, 0);
  DiagBuf   := malloc(4, 0);

  // === Initialize shared heap state ===
  *RegFile[REG_PRPPTR] := 0;
  *DescTable[0]        := DmaConf;
  *DmaConf[REG_PRPPTR] := 0;

  handler 0 {
    // NVME_ERR_EVT: corrupts SlotIdx (direct scalar) — bug source for micro1
    ErrCode  := ERR_INVAL;
    ErrCount := ErrCount + 1;
    SlotIdx  := LEFT_ABORT_SLOT
  };

  handler 1 {
    // TIMEOUT_EVT: corrupts RegFile[REG_PRPPTR] — bug source for micro2
    ErrCount             := ErrCount + 1;
    *RegFile[REG_PRPPTR] := ABORT_SLOT
  };

  handler 2 {
    // CQ_FULL_EVT: corrupts DmaConf[REG_PRPPTR] via 1-level alias — bug source for micro3
    DmaPtr              := DmaConf;
    *DmaPtr[REG_PRPPTR] := ABORT_SLOT
  }
}

main {
  NvmeCtrl := RegFile;
  while *NvmeCtrl[REG_PRPPTR] < PRP_SZ do (
    // [FIX-2] Capture RegFile[REG_PRPPTR] atomically: handler 1 cannot fire
    // between the read and the assignment when interrupts are disabled.
    // SafePrp is a plain variable not written by any handler, so the
    // if-check below is stable across the then-branch.
    disable;
    SafePrp := *NvmeCtrl[REG_PRPPTR];
    enable;
    if SafePrp < PRP_SZ
    then *PrpList[SafePrp] := 0
    else unit;
    *RegFile[REG_PRPPTR] := *RegFile[REG_PRPPTR] + 1
  )
}
