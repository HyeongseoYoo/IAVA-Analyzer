// micro3_aliasmulti_buggy.si — Pattern 3: multi-depth heap alias (BUGGY)
// Bug: handler 2 corrupts DmaConf[REG_PRPPTR] between if-check and then-branch.
// Expected: 1 interrupt warning, [caused by interrupt: handler 2]
// Fix: see micro3_aliasmulti_fixed.si — snapshot the value inside disable/enable
//
init {
  // === Array sizes ===
  MAX_SLOTS  := 8;
  PRP_SZ     := 8;
  TX_TOTAL   := 10;
  REG_SZ     := 4;

  // === OOB sentinel ===
  ABORT_SLOT := 255;

  // === Register field indices ===
  REG_STATUS := 0;
  REG_PRPPTR := 1;
  REG_ERRCNT := 2;

  // === Error codes ===
  ERR_NONE    := 0;
  ERR_INVAL   := 1;
  ERR_TIMEOUT := 2;

  // === State variables ===
  SlotIdx  := 0;
  ErrCode  := 0;
  ErrCount := 0;

  // === Arrays ===
  SqBuf     := malloc(8, 0);
  RegFile   := malloc(4, 0);
  PrpList   := malloc(8, 0);
  DmaConf   := malloc(4, 0);
  DescTable := malloc(4, 0);
  PrpList2  := malloc(8, 0);
  TxBuf     := malloc(8, 0);
  DiagBuf   := malloc(4, 0);

  // === Initialize shared heap state ===
  *RegFile[REG_PRPPTR] := 0;
  *DescTable[0]        := DmaConf;
  *DmaConf[REG_PRPPTR] := 0;

  handler 0 {
    // NVME_ERR_EVT: corrupts SlotIdx (direct scalar) — bug source for micro1
    ErrCode  := ERR_INVAL;
    ErrCount := ErrCount + 1;
    SlotIdx  := ABORT_SLOT
  };

  handler 1 {
    // TIMEOUT_EVT: corrupts RegFile[REG_PRPPTR] — bug source for micro2
    ErrCount             := ErrCount + 1;
    *RegFile[REG_PRPPTR] := ABORT_SLOT
  };

  handler 2 {
    // CQ_FULL_EVT: corrupts DmaConf[REG_PRPPTR] via 1-level alias — bug source for micro3
    DmaPtr              := DmaConf;
    *DmaPtr[REG_PRPPTR] := ABORT_SLOT
  }
}

main {
  // 3-level alias chain to DmaConf (main side):
  //   level 1: SysRef is a var alias to DescTable
  //   level 2: EngRef is loaded by dereferencing DescTable[0], so EngRef aliases DmaConf
  //   level 3: *EngRef[REG_PRPPTR] reads DmaConf[REG_PRPPTR]
  // Handler 2's 2-level chain: DmaPtr := DmaConf; *DmaPtr[REG_PRPPTR] := 255
  // The aliasing is hidden: main reaches DmaConf through a heap-stored pointer,
  // while handler 2 names it directly.
  SysRef := DescTable;
  EngRef := *SysRef[0];
  // [BUG-3] handler 2 can corrupt DmaConf[REG_PRPPTR] via DmaPtr between the
  // if-check and the then-branch, turning the bounds guard into a false guarantee.
  if *EngRef[REG_PRPPTR] < PRP_SZ
  then *PrpList2[*EngRef[REG_PRPPTR]] := 0   // OOB: re-read may be 255
  else unit
}
